    "axios": "^1.16.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.6.3",
    "lucide-react": "^1.14.0",
    "materialize-css": "^1.0.0",
    "owl.carousel": "^2.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.3.5",
    "react-loading-skeleton": "^3.5.0",
    "react-owl-carousel": "^2.3.3",
    "react-redux": "^9.2.0",
    "react-rnd": "^10.5.3",
