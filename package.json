{
  "name": "kresla",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,api -c cyan,green \"vite\" \"npm run dev --prefix server\"",
    "dev:client": "vite",
    "dev:server": "npm run dev --prefix server",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "test": "npm run lint",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:server": "npm run start --prefix server",
    "pm2:start": "pm2 start pm2.config.cjs --env production",
    "pm2:stop": "pm2 stop mebel-api",
    "pm2:restart": "pm2 restart mebel-api",
    "pm2:logs": "pm2 logs mebel-api",
    "pm2:monit": "pm2 monit",
    "postinstall": "npm install --prefix server"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
