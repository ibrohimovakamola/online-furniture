# Frontend production (Vite build-time) — copy to .env.production locally
# Vercel: set these in Project → Settings → Environment Variables

# Separate API subdomain (Render backend)
VITE_API_BASE_URL=https://api.mebelsotish.uz/api
VITE_SERVER_URL=https://api.mebelsotish.uz

# App metadata (optional)
VITE_APP_NAME=KRESLA
VITE_APP_VERSION=1.0.0

# Legacy alias (still supported by src/config/apiBase.js):
# VITE_API_URL=https://api.mebelsotish.uz/api
