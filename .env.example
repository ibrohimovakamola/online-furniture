# ── Frontend production (build-time) ────────────────────────────────────────
# Copy to .env.production before: npm run build
# Vercel: set in Project → Environment Variables (Production)

# Render API + Vercel storefront (recommended split deploy)
VITE_API_BASE_URL=https://api.mebelsotish.uz/api
VITE_SERVER_URL=https://api.mebelsotish.uz

VITE_APP_NAME=KRESLA
VITE_APP_VERSION=1.0.0

# Same-origin deploy (Apache proxies /api → Node): use mebelsotish.uz for both
# VITE_API_BASE_URL=https://mebelsotish.uz/api
# VITE_SERVER_URL=https://mebelsotish.uz

# Legacy alias (still supported):
# VITE_API_URL=https://api.mebelsotish.uz/api
