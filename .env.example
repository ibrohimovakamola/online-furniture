# ── Vercel / production ─────────────────────────────────────────────────────
# Full API root (must include /api). Example:
# VITE_API_BASE_URL=https://your-backend.onrender.com/api

# Optional: backend origin for /uploads images (auto-derived from VITE_API_BASE_URL if omitted)
# VITE_SERVER_URL=https://your-backend.onrender.com

# Legacy alias (still supported):
# VITE_API_URL=https://your-backend.onrender.com/api

# ── Local dev ───────────────────────────────────────────────────────────────
# No .env required. Defaults to http://localhost:5000/api when npm run dev + server on :5000
