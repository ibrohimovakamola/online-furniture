# Copy to server/.env — never commit the real file
# Generate secrets: openssl rand -hex 32

NODE_ENV=production
PORT=5000
HOST=127.0.0.1
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# ── MongoDB Atlas (required) ───────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/mebel?retryWrites=true&w=majority&appName=mebelsotish

# ── Auth (required — min 32 chars each) ────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
REFRESH_SECRET=REPLACE_WITH_DIFFERENT_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ── Frontend / CORS ────────────────────────────────────────────────────────────
CLIENT_URL=https://mebelsotish.uz
CORS_ORIGIN=https://mebelsotish.uz,https://www.mebelsotish.uz
CORS_CREDENTIALS=false

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=10
CSRF_ENABLED=true
FORCE_HTTPS=true
API_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_MAX=3
CONTACT_RATE_LIMIT_MAX=10

# ── Seeds (keep false in production) ───────────────────────────────────────────
SEED_SUPER_ADMIN=false
SEED_ADMIN_DATA=false
SEED_CATEGORIES=false
SEED_RESET_ADMIN_PASSWORD=false

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_ALL_REQUESTS=false
SLOW_REQUEST_MS=2000
SWAGGER_ENABLED=false

# ── Performance ──────────────────────────────────────────────────────────────
SETTINGS_CACHE_MS=60000
LOW_STOCK_THRESHOLD=5

# ── Payme (https://merchant.paycom.uz) ───────────────────────────────────────
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
PAYME_SERVICE_ID=
PAYME_WEBHOOK_URL=https://mebelsotish.uz/api/payments/payme-callback
PAYME_RETURN_URL=https://mebelsotish.uz/payment/result
PAYME_TEST_MODE=false

# ── Click (https://my.click.uz) ──────────────────────────────────────────────
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_RETURN_URL=https://mebelsotish.uz/payment/result
CLICK_TEST_MODE=false

# ── Cloudinary (gallery + optional product CDN) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_GALLERY_FOLDER=mebel-gallery

# ── Email (Nodemailer) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@mebelsotish.uz
SMTP_PASS=
SMTP_FROM=Mebel Sotish <noreply@mebelsotish.uz>
B2B_ADMIN_EMAIL=admin@mebelsotish.uz

# Legacy Gmail alias (optional):
# EMAIL_SERVICE=gmail
# EMAIL_USER=
# EMAIL_PASSWORD=
