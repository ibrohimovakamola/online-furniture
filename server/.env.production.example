# Copy to server/.env on Render (Environment tab) — never commit the real file
# Generate secrets: openssl rand -hex 32

# ── MongoDB Atlas (required) ───────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/kresla?retryWrites=true&w=majority

NODE_ENV=production

# ── Server (Render sets PORT automatically; bind all interfaces) ─────────────
PORT=5000
HOST=0.0.0.0
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# Public API URL (custom domain on Render)
API_URL=https://api.mebelsotish.uz

# ── Auth (min 32 chars each) ─────────────────────────────────────────────────
JWT_SECRET=generate-a-strong-random-key-min-32-chars-use-openssl-rand-hex-32
REFRESH_SECRET=generate-a-different-strong-key-min-32-chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ── Frontend / CORS (Vercel storefront → Render API) ───────────────────────────
CLIENT_URL=https://mebelsotish.uz
CORS_ORIGIN=https://mebelsotish.uz,https://www.mebelsotish.uz
# Required for httpOnly refresh cookies when frontend and API are on different origins
CORS_CREDENTIALS=true
# Set true to allow https://*.vercel.app preview deployments
# CORS_ALLOW_VERCEL_PREVIEWS=true

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=10
CSRF_ENABLED=true
FORCE_HTTPS=true
API_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_MAX=3
CONTACT_RATE_LIMIT_MAX=10

# ── Seeds (keep false in production) ─────────────────────────────────────────
SEED_SUPER_ADMIN=false
SEED_ADMIN_DATA=false
SEED_CATEGORIES=false
SEED_RESET_ADMIN_PASSWORD=false

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_ALL_REQUESTS=false
SLOW_REQUEST_MS=2000
SWAGGER_ENABLED=false

# ── Payme (add when merchant ID ready) ───────────────────────────────────────
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
PAYME_SERVICE_ID=
PAYME_WEBHOOK_URL=https://api.mebelsotish.uz/api/payments/payme-callback
PAYME_RETURN_URL=https://mebelsotish.uz/payment/result
PAYME_TEST_MODE=false

# ── Click ────────────────────────────────────────────────────────────────────
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_RETURN_URL=https://mebelsotish.uz/payment/result
CLICK_TEST_MODE=false

# ── Uzum Bank ────────────────────────────────────────────────────────────────
UZUMBANK_MERCHANT_ID=
UZUMBANK_SECRET_KEY=
UZUMBANK_API_URL=https://api.uzumbank.uz/api/merchant
UZUMBANK_CHECKOUT_URL=https://checkout.uzumbank.uz/pay
UZUMBANK_TEST_MODE=false
UZUMBANK_RETURN_URL=https://mebelsotish.uz/payment/result
UZUMBANK_WEBHOOK_URL=https://api.mebelsotish.uz/api/payment/uzumbank/callback

# ── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_GALLERY_FOLDER=kresla-gallery

# ── Email (Nodemailer / SMTP) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=Kresla <noreply@mebelsotish.uz>
B2B_ADMIN_EMAIL=admin@mebelsotish.uz

# Legacy Gmail aliases (optional):
# NODEMAILER_EMAIL=your-email@gmail.com
# NODEMAILER_PASS=your-app-specific-password
# EMAIL_USER=
# EMAIL_PASSWORD=
