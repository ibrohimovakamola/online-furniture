PORT=5000
NODE_ENV=development

# Comma-separated allowed browser origins (dev). Falls back to CLIENT_URL if unset.
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ── Option 1: In-memory MongoDB (zero setup, good for local dev/testing) ────
# Uses mongodb-memory-server by default. Set USE_SPAWN_MONGOD=true to prefer a
# spawned local mongod on Windows (port 27017) with memory-server as fallback.
MONGODB_URI=memory
MEMORY_DB_PERSIST=false
USE_SPAWN_MONGOD=false
# When C: is low on space, store MongoDB data/binaries elsewhere (Windows example):
# DEV_MONGO_DATA_DIR=D:\.exclusive-dev-mongo
# MONGOD_VERSION=7.0.14
SEED_CATEGORIES=true

# ── Option 2: MongoDB Atlas (persistent cloud database) ─────────────────────
# 1. https://cloud.mongodb.com → free M0 cluster
# 2. Database Access → create user
# 3. Network Access → allow 0.0.0.0/0 (dev only)
# 4. Connect → Drivers → copy URI, set database name: ...mongodb.net/exclusive?...
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/exclusive?retryWrites=true&w=majority

# ── Option 3: Local MongoDB service ──────────────────────────────────────────
# MONGODB_URI=mongodb://127.0.0.1:27017/exclusive

JWT_SECRET=change-this-to-a-long-random-string-in-production
REFRESH_SECRET=change-this-to-a-different-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

SEED_SUPER_ADMIN=true
SUPER_ADMIN_EMAIL=admin@exclusive.uz
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Set true once to force admin password re-hash; auto-flips back to false on boot
SEED_RESET_ADMIN_PASSWORD=false

# Seed demo categories, products, and a sample order on first boot
SEED_ADMIN_DATA=true

# B2B email notifications (logs to console in dev; set SMTP for production)
B2B_ADMIN_EMAIL=admin@exclusive.uz

# ── Security ───────────────────────────────────────────────────────────────────
# CORS: comma-separated origins (no wildcards in production)
# CORS_CREDENTIALS=true required for httpOnly refresh cookies in cross-origin dev
CORS_CREDENTIALS=true
# Bcrypt cost factor (default 10)
BCRYPT_ROUNDS=10
# Rate limits (optional overrides)
# API_RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_MAX=5
# PASSWORD_RESET_RATE_LIMIT_MAX=3
# CONTACT_RATE_LIMIT_MAX=10
# CSRF_ENABLED=true
# FORCE_HTTPS=true
# LOG_ALL_REQUESTS=false
# SLOW_REQUEST_MS=2000
# LOG_LEVEL=info

# ── Email (Nodemailer) — order, payment, auth, contact notifications ─────────
# Without SMTP/EMAIL config the server logs emails to the console in dev.
#
# Option A — Gmail (app password required):
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-specific-password
#
# Option B — Dedicated SMTP (SendGrid, Mailgun, etc.):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password
#
# EMAIL_* aliases map to SMTP_USER / SMTP_PASS when SMTP_* are unset.
# SMTP_FROM=Mebel Sotish <noreply@mebelsotish.uz>
# MAIL_FROM=Mebel Sotish <noreply@mebelsotish.uz>

# ── Payme (https://merchant.paycom.uz) ───────────────────────────────────────
# Production webhook: https://mebelsotish.uz/api/payments/payme-callback
# Legacy alias: /api/payments/payme/webhook | /api/payment/payme/webhook
# PAYME_MERCHANT_ID=
# PAYME_MERCHANT_KEY=   # Secret key (or PAYME_KEY legacy alias)
# PAYME_SERVICE_ID=
# PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# PAYME_TEST_MODE=false
# PAYME_WEBHOOK_URL=https://mebelsotish.uz/api/payments/payme-callback
# PAYME_RETURN_URL=https://mebelsotish.uz/payment/result
# PAYME_ALLOWED_IPS=  # optional comma-separated Payme server IPs

# ── Click (https://my.click.uz) ──────────────────────────────────────────────
# Register callback: https://mebelsotish.uz/api/payments/click-callback
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=
# CLICK_TEST_MODE=false
# CLICK_RETURN_URL=https://mebelsotish.uz/payment/result
# CLICK_STATUS_URL=https://api.click.uz/v2/merchant/payment/status

# ── Cloudinary (gallery image hosting) ───────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_GALLERY_FOLDER=mebel-gallery
