# Dependencies
node_modules/
server/node_modules/

# Build output
dist/
dist-ssr/
build/

# Environment & secrets (never commit)
.env
.env.*
.env.production
.env.local
!.env.example
!server/.env.example
!server/.env.production.example
*.local

# Backend uploads & local DB
server/uploads/
server/.mongo-memory/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vercel / tooling
.vercel/

# Editor & OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test / coverage
coverage/

# PHP scaffold (php-app)
php-app/vendor/
php-app/.env
php-app/logs/*.log
php-app/cache/*
!php-app/cache/.gitkeep
php-app/uploads/temp/*
!php-app/uploads/temp/.gitkeep
